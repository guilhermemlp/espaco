# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE (PADRÃO DO APP):
# Com URL e chave válidas, o app usa login por conta e guarda os dados por usuário.
# Defina "false" apenas para um modo 100% local (sem login e sem nuvem).
VITE_ENABLE_SUPABASE="true"

# CREDENCIAIS SUPABASE:
# Use a URL do projeto e a chave pública (anon/publishable) do Supabase.
VITE_SUPABASE_URL="https://sua-url-supabase.supabase.co"
VITE_SUPABASE_ANON_KEY="sua-chave-anon-publica-supabase"

# Passos:
# 1. Execute supabase/schema.sql no SQL Editor do projeto.
# 2. Preencha as duas variáveis acima.
# 3. Reinicie o servidor de desenvolvimento.
#
# O PIN de bloqueio nunca é enviado para a nuvem.
#
# GEMINI_API_KEY e APP_URL não são necessários para o funcionamento atual.
